# Veerexa School Lead Finder — Environment Variables
# Copy this file to .env and fill in your values.

# ── Google Places API ────────────────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/
# Enable "Places API (New)" — NOT the legacy Places API
# Create an API key and restrict it to: Places API (New)
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here

# ── Request Limits ────────────────────────────────────────────────────────────
# Maximum API requests per single Fetch-Schools run (default: 100)
MAX_REQUESTS_PER_RUN=100

# Maximum API requests allowed in a single calendar day (default: 500)
DAILY_REQUEST_LIMIT=500
